# Security headers for the Secure Call web app (PLAN.md sections 3.4 and 3.5).
# Vite copies this file into dist/, and .github/workflows/deploy-web.yml uploads it to
# public_html on securevideocall.com (Apache). The host already redirects HTTP to HTTPS.
#
# Never weaken these to make something work (CLAUDE.md). The backend address in connect-src
# must match the signaling server the app talks to.

Options -Indexes

# Say UTF-8 in the Content-Type of the HTML, JS and CSS the build emits (ASVS V4.1.1), not only in
# <meta charset>. The build check (securityHeadersCheck.ts) and scripts/verify-deployed.mjs
# both require this. Add the extension here if the build ever emits .svg, .json or .webmanifest.
AddDefaultCharset UTF-8
AddCharset utf-8 .js .css

Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; script-src-attr 'none'; style-src 'self'; img-src 'self' data: blob:; media-src 'self' blob:; font-src 'none'; connect-src 'self' wss://signal.securevideocall.com; worker-src 'none'; frame-src 'none'; manifest-src 'none'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; require-trusted-types-for 'script'; trusted-types 'none'; upgrade-insecure-requests"
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "no-referrer"
Header always set Permissions-Policy "camera=(self), microphone=(self), display-capture=(self), geolocation=(), payment=(), usb=()"
Header always set Cross-Origin-Opener-Policy "same-origin"
Header always set Cross-Origin-Resource-Policy "same-origin"
Header always set X-Frame-Options "DENY"

# index.html is always re-checked, so a new deploy shows up at once; the hashed files in
# assets/ never change, so browsers may keep them for a year.
<FilesMatch "^index\.html$">
  Header set Cache-Control "no-cache"
</FilesMatch>
<If "%{REQUEST_URI} =~ m#^/assets/#">
  Header set Cache-Control "public, max-age=31536000, immutable"
</If>
